environment                = "prod"
# data_folder_id             = "folders/000000000000" # Supplied by 00_linked.auto.tfvars.json (uncomment only for standalone override)
# billing_account            = "000000-000000-000000" # Supplied by 00_linked.auto.tfvars.json (uncomment only for standalone override)
prefix                     = "ent"
project_suffix             = "" # Leave empty when auto_unique_suffix = true
auto_unique_suffix         = true
region                     = "asia-southeast1"
# kms_key_id                 = "" # Supplied by 00_linked.auto.tfvars.json (uncomment only for standalone override)
domain_marts               = ["fin"]
deletion_protection        = true
project_deletion_policy    = "PREVENT"
delete_contents_on_destroy    = false
soft_delete_retention_seconds = 2592000
enable_dual_region_gcs        = false
# dual_region_location        = "ASIA" # Valid ASIA dual-region code (or use predefined NAM4 / EUR4)
# dual_region_data_locations  = ["asia-southeast1", "asia-east1"] # Valid ASIA pair (GCS excludes asia-southeast2)
# gcs_rpo                     = "ASYNC_TURBO"
enable_reservations = true
# 0 baseline slots = $0/mo idle vs $5,365.50/mo PAYG for 100 baseline slots in asia-southeast1.
baseline_slots       = 0
max_slots            = 400
etl_baseline_slots   = 0
etl_max_slots        = 400
bi_baseline_slots    = 0
bi_max_slots         = 400
adhoc_baseline_slots = 0
adhoc_max_slots      = 200
enforce_vpc_sc             = false # Flip to true only after all stages join the dry-run perimeter and ingress principals are verified
immutable_image_tags       = true
masked_readers             = ["user:analyst@example.com"]
bi_analysts                = ["user:bi-viewer@example.com"]
