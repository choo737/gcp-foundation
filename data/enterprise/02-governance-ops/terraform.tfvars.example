environment                  = "dev"
region                       = "asia-southeast1"
prefix                       = "ent"
medallion_git_url            = "https://github.com/choo737/gcp-data-medallion.git"
enable_scheduled_workflow    = false
enable_quality_scan          = true
delete_contents_on_destroy   = false
