environment             = "prod"
shared_infra_folder_id  = "folders/000000000000"
billing_account         = "000000-000000-000000"
prefix                  = "ent"
project_suffix          = "prd01"
region                  = "asia-southeast1"
project_deletion_policy = "PREVENT"
enable_cmek             = true
kms_protection_level    = "HSM"
enable_vpc              = true
enable_shared_vpc_host  = true
enable_vpc_flow_logs    = true
vpc_flow_logs_sampling  = 1.0
enable_dns_logging      = true
enable_psc              = true
enable_vpc_sc           = true
enforce_vpc_sc          = true
enable_alerts           = true
