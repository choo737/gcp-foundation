project_id           = "seed-admin-project-id"
region               = "asia-southeast1"
prefix               = "ent"
project_suffix       = "dev01"
enable_github_wif    = false
github_org           = "" # Example: "acme-corp"
github_repositories  = [] # Example: ["acme-corp/gcp-foundation", "acme-corp/gcp-data-ingestion"]
allowed_refs         = ["refs/heads/main", "refs/tags/*"]
allowed_environments = ["dev", "staging", "prod"]
force_destroy        = false
