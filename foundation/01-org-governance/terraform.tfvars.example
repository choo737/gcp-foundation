parent_id                     = "organizations/000000000000"
billing_account               = "000000-000000-000000"
prefix                        = "ent"
project_suffix                = "dev01"
region                        = "asia-southeast1"
dr_region                     = null
environments                  = ["dev", "staging", "prod"]
deletion_protection           = true
project_deletion_policy       = "PREVENT"
delete_contents_on_destroy    = false
lock_audit_bucket             = true
enable_audit_project_lien     = true
enable_log_analytics          = true
enable_log_analytics_link     = true
enable_siem_pubsub_sink       = false
scc_tier                      = "NONE" # Options: "NONE", "STANDARD" (free), "PREMIUM" (paid)
# scc_location                = "global" # SCC v2 API location: global, us, eu, or sa (BQ export stays in region)
# scc_alert_email_addresses   = ["secops@example.com"]
# enable_security_posture     = false # Optional in PREMIUM; requires organization_id or org parent_id
# organization_id             = "organizations/000000000000"
enable_scc_notifications      = false
enable_org_policies           = false
allowed_policy_member_domains = [] # Example: ["C00000000"]
allowed_contact_domains       = [] # Example: ["@example.com"]
essential_contacts            = {} # Example: { security = { email = "secops@example.com", categories = ["SECURITY"] } }
foundation_iam_groups         = {} # Example: { audit_viewer = "grp-gcp-audit-viewer@example.com" }
enable_billing_budget         = true
monthly_budget_amount         = 500
budget_currency_code          = "USD"
